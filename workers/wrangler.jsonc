{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gbti-payment-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gbti-payment-orders",
      "database_id": "584055b9-e6e3-450e-a192-a2d25b09f762",
      "migrations_dir": "migrations"
    }
  ],
  // Keep KV available for any leftover data; primary store is D1.
  "kv_namespaces": [
    {
      "binding": "ORDERS",
      "id": "f0d2ab1b760944a7841347342b353ee6"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": ""
  }
  // Secrets (wrangler secret put — never commit):
  //   WEBHOOK_SECRET
  //   FIREBASE_PROJECT_ID
  //   FIREBASE_CLIENT_EMAIL
  //   FIREBASE_PRIVATE_KEY
}
