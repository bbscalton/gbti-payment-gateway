rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sapp — Order status mirror
    // NEVER stores PAN, CVV, or expiry in these documents.
    // Writes only from Admin SDK / Worker service account (bypasses rules).
    
    // Orders: Read only specific order by ID (no list enumeration)
    // In production, add merchant ID matching for proper scoping
    match /orders/{orderId} {
      // Allow read of a specific document by ID only
      // Block list queries by requiring the document ID to be known
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    
    // Merchants collection (if mirrored)
    match /merchants/{merchantId} {
      allow read: if false;
      allow write: if false;
    }

    // Block all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
