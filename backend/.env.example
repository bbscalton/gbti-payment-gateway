# Sandbox / mock configuration ONLY — not real GBTI credentials.
# Copy to .env and adjust for local development.

PORT=3000
# Shared secret used to HMAC-sign mock processor webhooks.
# Production would use real acquirer webhook signing keys from GBTI.
WEBHOOK_SECRET=gbti_sandbox_webhook_secret_change_me
# Public base URL returned in hosted checkout links (emulator uses 10.0.2.2).
PUBLIC_BASE_URL=http://10.0.2.2:3000
